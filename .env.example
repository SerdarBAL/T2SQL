# --- LLM (Gemini) ---
# https://aistudio.google.com/apikey adresinden ücretsiz al
GOOGLE_API_KEY=your-gemini-api-key-here
LLM_PROVIDER=gemini            # gemini | openai | anthropic (provider-agnostic katman)
LLM_MODEL=gemini-2.0-flash

# --- Database (PostgreSQL / Olist) ---
POSTGRES_USER=t2sql
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olist
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Uygulama read-only rol ile bağlanır (güvenlik):
DATABASE_URL=postgresql+psycopg://t2sql_readonly:change-me@localhost:5432/olist

# --- App ---
SQL_STATEMENT_TIMEOUT_MS=10000
MAX_SELF_CORRECT_RETRIES=3
