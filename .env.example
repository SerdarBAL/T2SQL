# --- LLM ---
LLM_PROVIDER=groq              # groq | gemini | openai | anthropic (provider-agnostic katman)
LLM_MODEL=llama-3.3-70b-versatile
# Groq (aktif): https://console.groq.com/keys — cömert ücretsiz kota
GROQ_API_KEY=your-groq-api-key-here
# Gemini (yedek): https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# --- Database (PostgreSQL / Olist) ---
POSTGRES_USER=t2sql
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olist
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
# Uygulamanın kullandığı salt-okunur rol (docker-compose ilk açılışta oluşturur):
APP_READONLY_USER=t2sql_readonly
APP_READONLY_PASSWORD=change-me-readonly
# Agent, Olist sorguları için read-only rol ile bağlanır (güvenlik):
DATABASE_URL=postgresql+psycopg://t2sql_readonly:change-me-readonly@localhost:15432/olist
# Uygulama, kendi metadata'sı (sohbet geçmişi) için yazılabilir owner rolü kullanır.
# Bu tablolar `app` şemasında; agent şeması (public) bunları GÖRMEZ.
APP_DATABASE_URL=postgresql+psycopg://t2sql:change-me@localhost:15432/olist

# --- App ---
SQL_STATEMENT_TIMEOUT_MS=10000
MAX_SELF_CORRECT_RETRIES=3
